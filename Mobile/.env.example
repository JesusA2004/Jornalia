# Copia este archivo a .env.local y ajusta los valores.
# URL base de la API v1. Desde el emulador Android, 10.0.2.2 apunta al host.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# development | preview | production
APP_VARIANT=development
# Paquete Android / bundle iOS (por defecto mx.mrlana.asistencias)
ANDROID_PACKAGE=mx.mrlana.asistencias
# projectId de EAS (requerido para obtener el token push de Expo)
EAS_PROJECT_ID=
