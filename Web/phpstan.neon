includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Larastan lee los tipos de `casts()` de cada modelo (fechas, enums, booleanos).
    parseModelCastsMethod: true
