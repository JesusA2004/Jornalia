APP_NAME="MR LANA Asistencias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jornalia
DB_USERNAME=jornalia_app
DB_PASSWORD=
# InnoDB es obligatorio (transacciones, llaves foráneas, triggers e índices utf8mb4).
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Renderizado del lado del servidor de Inertia (las pruebas lo desactivan).
INERTIA_SSR_ENABLED=true

# ── Integridad del registro de asistencias ───────────────────────────────
# Claves de 64 hex: php -r "echo bin2hex(random_bytes(32));"
# Respáldelas fuera del servidor: sin ellas no puede verificarse la cadena histórica.
INTEGRITY_CHAIN_KEY=
INTEGRITY_ANCHOR_KEY=
INTEGRITY_ANCHOR_DISK=anchors
INTEGRITY_ANCHOR_PATH=
PUNCH_CHALLENGE_TTL=120
MOBILE_TOKEN_TTL=20160
DEVICE_AUTO_APPROVE_FIRST=false

# ── Notificaciones push (Firebase Cloud Messaging HTTP v1) ───────────────
# Ver docs/notificaciones/PUSH.md. La cuenta de servicio es un SECRETO: fuera del
# repo y de public/. Indique la RUTA (preferida) o el JSON inyectado, no ambos.
# Vacío = push deshabilitado (la bandeja de la app sigue funcionando).
FCM_HABILITADO=false
FCM_PROJECT_ID=
FCM_CREDENCIALES_RUTA=
FCM_CREDENCIALES_JSON=
FCM_PRESUPUESTO_MS=8000
FCM_CONEXION_MS=2000
# Bundle CA PEM opcional (nunca desactiva la verificación TLS).
FCM_CA=
# Canal Android de alta importancia que crea la app.
FCM_CANAL_ANDROID=avisos

# ── Integración MR LANA People (opcional; deshabilitada si está vacía) ─────
PEOPLE_API_URL=
PEOPLE_API_TOKEN=

# ── Instalación inicial (sólo para automatizar `asistencias:instalar`) ─────
INSTALL_ADMIN_PASSWORD=

# Verificación facial open source (services/face). Vacío = no disponible.
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
